# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classification_eval

# PostgreSQL schema to use
DB_SCHEMA=magellan

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=5000

NODE_ENV=development

# ── Data source ───────────────────────────────────────────────────────────────
# Where to read run data from: "postgres" or "csv" (case-insensitive)
DATA_SOURCE=POSTGRES

# ── OpenAI (used for attribute translation) ───────────────────────────────────
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for translation and Ask GPT (default: gpt-oss)
OPENAI_MODEL=gpt-oss

# Chat completions endpoint — override to use a proxy or compatible API (default: OpenAI)
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional translation-specific endpoint/model/lang (fallback to OPENAI_* when omitted)
TRANSLATE_GPT_URL=https://api.openai.com/v1/chat/completions
TRANSLATE_GPT_MODEL=gpt-oss
TRANSLATE_DESTINATION_LANGUAGE=English

# Number of parallel translation requests (default: 10)
OPENAI_CONCURRENCY=10

# Maximum number of entries in the value-level translation cache (default: 100000)
TRANSLATION_CACHE_MAX_SIZE=100000

# ── Ask GPT (Record Details column) ──────────────────────────────────────────
# Optional custom prompt for per-record Ask GPT in Record Details.
# Supported placeholders: {attributes}, {metadata}, {suggested_type}, {suggested_subtype}
# If empty, the server falls back to Stage-1 style subtype classification prompt.
ASK_GPT_PROMPT=Classify this record into the best subtype. Return exactly two lines: SUBTYPE: <label> and REASON: <short reason>. Attributes: {attributes} Metadata: {metadata}

# Optional fallback Stage-1 context (used only when ASK_GPT_PROMPT is empty)
ASK_GPT_DOMAIN_NAME=e-commerce product support
ASK_GPT_DOMAIN_INSTRUCTIONS=Use semantic meaning from attributes and metadata. If signal is weak, return SUBTYPE: unknown.
